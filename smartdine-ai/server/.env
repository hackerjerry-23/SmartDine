PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/smartdine

JWT_SECRET=SmartDine@123456
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

GEMINI_API_KEY=your_gemini_api_key
# Optional override - defaults to Google's auto-updated "gemini-flash-latest" alias
GEMINI_MODEL=gemini-flash-latest

# Optional fallback SMTP sender - only used until an admin configures their
# own email from Admin -> Settings inside the app. Once someone saves
# settings there, those take priority and these are ignored. You can leave
# these blank if every deployment will just use the in-app settings page.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Required to store the in-app email app-password securely (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, JWT_SECRET is used instead - but setting a dedicated key is
# recommended so rotating one doesn't invalidate the other.
SETTINGS_ENCRYPTION_KEY=replace_with_a_long_random_string

CLIENT_URL=http://localhost:5173

# Tunable business rules for the Smart Table Optimizer
DEFAULT_DINING_DURATION_MIN=60
TABLE_BUFFER_MIN=5
